# Variables de entorno de la API M1PAES (plantilla — ver ADR-001/002/003)
# Copia este archivo como backend/.env y completa los valores.
# backend/.env está en .gitignore y NUNCA se versiona.

# --- API ---
NODE_ENV=development
PORT=3000
# Origen permitido para CORS. Vacío = mismo origen (frontend servido por la API).
CORS_ORIGIN=

# --- Base de datos (ADR-002) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=m1paes
DB_USER=postgres
DB_PASSWORD=<tu contraseña local de PostgreSQL>
DB_POOL_MAX=10
# Base administrativa para crear/borrar bases en scripts (db:reset).
DB_ADMIN_NAME=postgres

# --- Autenticación (ADR-003) ---
# Secreto para firmar los JWT de sesión (>= 48 bytes aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En desarrollo puede quedar vacío (se genera uno efímero al arrancar);
# en producción el arranque falla si falta o es corto.
JWT_SECRET=
# Duración de la sesión (horas).
JWT_EXPIRES_HOURS=8

# --- Producción (no necesarios para desarrollo local) ---
# Dominio público, HTTPS obligatorio en producción.
APP_BASE_URL=https://m1paes.online
# En Render, el servicio va detrás de su proxy HTTPS.
TRUST_PROXY=1
# API HTTPS de Resend (no usar una clave real en este archivo).
RESEND_API_KEY=
EMAIL_FROM="M1PAES <no-reply@m1paes.online>"
